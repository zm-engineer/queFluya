generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Language {
  EN
  ES
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SessionStatus {
  WAITING
  ACTIVE
  ENDED
}

enum ReservationStatus {
  OPEN
  BOOKED
  CANCELLED
}

// The `user_id` column has a manual foreign key to `auth.users(id)` with
// `ON DELETE CASCADE`, added via raw SQL in Supabase:
//
//   alter table public.profiles
//     add constraint profiles_user_id_fkey
//     foreign key (user_id) references auth.users(id) on delete cascade;
//
// Prisma does not model this relation because `auth.users` lives in the
// `auth` schema, outside Prisma's tracked schemas. Prisma will not see or
// touch the constraint on `prisma db push`, so the cascade survives schema
// changes. If you ever enable `multiSchema` with `schemas = ["public", "auth"]`,
// remember to model `auth.users` (and ignore the rest of Supabase's auth
// tables) so Prisma does not drop this FK as drift.
model Profile {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String               @unique @map("user_id") @db.Uuid
  username       String               @unique
  nativeLanguage Language             @map("native_language")
  targetLanguage Language             @map("target_language")
  level          Level                @default(BEGINNER)
  avatarUrl      String?              @map("avatar_url")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at")
  topicProgress  TopicProgress[]
  recordings     Recording[]
  hostedSessions TandemSession[]      @relation("HostedSessions")
  sessionMembers SessionParticipant[]
  chatMessages   ChatMessage[]
  hostedReservations TandemReservation[] @relation("HostedReservations")
  guestReservations  TandemReservation[] @relation("GuestReservations")

  @@map("profiles")
}

model TopicProgress {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  topicSlug   String    @map("topic_slug")
  section     Int       @default(1)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, topicSlug, section])
  @@map("topic_progress")
}

// A learning topic — what the user sees on the dashboard and opens to study.
// `language` is the language being PRACTICED (i.e. it matches a learner's
// `target_language`, not their native one). `content` holds an array of
// sections as JSON; the shape lives in lib/topics.ts so we can iterate it
// without DB migrations while the content model stabilises.
model Topic {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  title       String
  description String
  language    Language
  level       Level
  position    Int      @default(0)
  // Links the two mirror topics of a language exchange (e.g. `greetings` EN
  // and `saludos` ES share pair_key "greetings"). Lets the tandem show each
  // side's vocabulary per timer phase, and will key the Phase-2 matchmaking.
  pairKey     String?  @map("pair_key")
  content     Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("topics")
}

// A 1:1 tandem text-chat session, scoped to a single topic. Phase 1 of the
// "Conectar" section: two learners practise the topic's language together via
// text, guided by a 5 min EN / 5 min ES timer. Entry is by shareable invite
// code (matchmaking queue is a later phase).
model TandemSession {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicSlug     String               @map("topic_slug")
  language      Language
  pairKey       String?              @map("pair_key")
  inviteCode    String               @unique @map("invite_code")
  status        SessionStatus        @default(WAITING)
  hostProfileId String               @map("host_profile_id") @db.Uuid
  startedAt     DateTime?            @map("started_at")
  endedAt       DateTime?            @map("ended_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  host          Profile              @relation("HostedSessions", fields: [hostProfileId], references: [id], onDelete: Cascade)
  participants  SessionParticipant[]
  messages      ChatMessage[]
  reservation   TandemReservation?

  @@index([inviteCode])
  // Matchmaking queue lookup: find a WAITING session by pair_key + language.
  @@index([status, pairKey, language])
  @@map("tandem_sessions")
}

// A scheduled 1:1 tandem: a host publishes an OPEN slot (topic + time), a guest
// books it (BOOKED), and at the time both join a TandemSession (session_id).
// scheduled_at is Timestamptz (unlike the rest of the schema's naive timestamps)
// because reservations do real future-time math — see parseDbTimestamp notes.
model TandemReservation {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostProfileId  String            @map("host_profile_id") @db.Uuid
  hostUsername   String?           @map("host_username")
  topicSlug      String            @map("topic_slug")
  language       Language
  pairKey        String?           @map("pair_key")
  scheduledAt    DateTime          @map("scheduled_at") @db.Timestamptz(3)
  status         ReservationStatus @default(OPEN)
  guestProfileId String?           @map("guest_profile_id") @db.Uuid
  guestUsername  String?           @map("guest_username")
  sessionId      String?           @unique @map("session_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  host           Profile           @relation("HostedReservations", fields: [hostProfileId], references: [id], onDelete: Cascade)
  guest          Profile?          @relation("GuestReservations", fields: [guestProfileId], references: [id], onDelete: SetNull)
  session        TandemSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // Browse-open-slots lookup: OPEN reservations by pair_key + language + time.
  @@index([status, pairKey, language, scheduledAt])
  @@map("tandem_reservations")
}

model SessionParticipant {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String        @map("session_id") @db.Uuid
  profileId String        @map("profile_id") @db.Uuid
  joinedAt  DateTime      @default(now()) @map("joined_at")
  session   TandemSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([sessionId, profileId])
  @@map("session_participants")
}

model ChatMessage {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String        @map("session_id") @db.Uuid
  profileId String        @map("profile_id") @db.Uuid
  body      String
  createdAt DateTime      @default(now()) @map("created_at")
  session   TandemSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model Recording {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId         String   @map("profile_id") @db.Uuid
  topicSlug         String   @map("topic_slug")
  originalUrl       String?  @map("original_url")
  transcription     String?
  correctedText     String?  @map("corrected_text")
  correctedAudioUrl String?  @map("corrected_audio_url")
  createdAt         DateTime @default(now()) @map("created_at")
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("recordings")
}
