generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Language {
  EN
  ES
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Profile {
  id             String          @id @default(uuid())
  userId         String          @unique @map("user_id")
  username       String          @unique
  nativeLanguage Language        @map("native_language")
  targetLanguage Language        @map("target_language")
  level          Level           @default(BEGINNER)
  avatarUrl      String?         @map("avatar_url")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  topicProgress  TopicProgress[]
  recordings     Recording[]

  @@map("profiles")
}

model TopicProgress {
  id          String   @id @default(uuid())
  profileId   String   @map("profile_id")
  topicSlug   String   @map("topic_slug")
  section     Int      @default(1)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, topicSlug, section])
  @@map("topic_progress")
}

model Recording {
  id              String   @id @default(uuid())
  profileId       String   @map("profile_id")
  topicSlug       String   @map("topic_slug")
  originalUrl     String   @map("original_url")
  transcription   String?
  correctedText   String?  @map("corrected_text")
  correctedAudioUrl String? @map("corrected_audio_url")
  createdAt       DateTime @default(now()) @map("created_at")
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("recordings")
}